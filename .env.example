# DOIP MVP backend base URL. Optional — the app runs fully offline without it.
# Default when unset: http://localhost:8000
VITE_DOIP_API_URL=http://localhost:8000

# Backend AI Model endpoint (LM Studio / local OpenAI-compatible endpoint)
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_BASE=http://localhost:1234/v1
OPENAI_MODEL=gemma-4-e4b-it-ultra-uncensored-heretic
OPENAI_FAST_MODEL=gemma-4-e4b-it-ultra-uncensored-heretic
OPENAI_API_KEY=not-needed

# Tactical Map API Key configuration (MapTiler / Mapbox / custom)
# If left empty, DOIP seamlessly falls back to free Carto Dark Matter + Esri World Imagery
VITE_MAP_API_KEY=
VITE_MAPTILER_API_KEY=
VITE_MAPBOX_TOKEN=
